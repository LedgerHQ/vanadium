# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Symlink farm created by the build-cases justfile recipes: the benchmark
# cases are members of a workspace, so cargo writes binaries to the shared
# target/ dir; the recipes link them back into each case directory so that
# tools can locate the ELF next to the crate's Cargo.toml
/bench/cases/*/target/
/apps/bitcoin/benchmarks/cases/*/target/

# Cargo.lock is tracked for every workspace that produces final artifacts:
# the root workspace (cargo-vnd and the SDKs), the Vanadium VM app, the V-App
# workspaces (apps/*), and the benchmark suites. The vendored libraries in
# libs/ follow the library convention and don't track a lockfile.
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock
!/Cargo.lock
!/vm/Cargo.lock
!/apps/*/Cargo.lock
!/apps/bitcoin/benchmarks/Cargo.lock
!/bench/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# It's convenient to use a virtual environment for speculos,
# so we ignore these folders if present.
venv
.venv

# Used when debugging the V-App clients
**/debug.log
**/print.log

# Produced in integration tests with speculos
**/test.log
